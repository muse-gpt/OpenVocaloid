{
    "name": "@wae/open-voice",
    "version": "0.0.1",
    "description": "Vocal synthesis: deterministic formant songs from syllable specs, WAV export — a library first, the CLI is a thin shell",
    "license": "Apache-2.0",
    "type": "module",
    "bin": {
        "open-voice": "dist/cli/main.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "locales",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "keywords": [
        "singing",
        "voice",
        "synthesis",
        "wae"
    ],
    "engines": {
        "node": ">=18"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/muse-gpt/OpenVoice.git",
        "directory": "packages/open-voice"
    },
    "optionalDependencies": {
        "@wae/open-voice-darwin-arm64": "workspace:*",
        "@wae/open-voice-darwin-x64": "workspace:*",
        "@wae/open-voice-linux-arm64": "workspace:*",
        "@wae/open-voice-linux-x64": "workspace:*",
        "@wae/open-voice-win32-x64": "workspace:*"
    },
    "dependencies": {
        "@wae/commander": "^0.0.6"
    },
    "devDependencies": {
        "@types/node": "^22.20.4",
        "typescript": "^5.9.2"
    }
}
